# --- Primary provider: Anthropic (Claude) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Failover provider: Google (Gemini) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Either key alone is a supported configuration. With both set, Claude serves
# and Gemini catches transient failures.

# --- Optional overrides ---
# auto (default) | anthropic | google  -- force a single provider for demos
# CALORAI_PROVIDER=auto
# CALORAI_TEXT_MODEL=claude-haiku-4-5-20251001
# CALORAI_VISION_MODEL=claude-sonnet-5
# CALORAI_TEXT_TIMEOUT=6

# --- Optional: LangSmith tracing (no code change needed) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=calorai
